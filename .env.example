# --- Server ---
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# --- Room lifecycle ---
ROOM_TTL_SECONDS=3600
STEAL_TIMER_SECONDS=20

# --- Supabase / Postgres (permanent question/answer dataset only) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Redis (optional; falls back to in-memory game state when unset) ---
REDIS_URL=

# --- LLM provider (AI Host agent: judging, game flow, and commentary) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5
# Per-call timeout; if the model is slower, the built-in canned host covers that moment.
LLM_TIMEOUT_MS=10000
# Optional: low|medium|high. Unset = "low" on models that take an effort setting, omitted otherwise.
LLM_EFFORT=

# --- AI Host ---
# With LLM_API_KEY empty the AI host still runs the whole game using canned lines.
AI_HOST_ROUNDS=5

# --- Embeddings (Tier 2 vector matching) ---
# "local" runs Xenova/all-MiniLM-L6-v2 on-device via @huggingface/transformers:
# free, no API key, no network calls per embedding. 384 dimensions.
# See docs/dataset.md before changing the model or dimension.
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Matching thresholds ---
EXACT_MATCH_THRESHOLD=1.0
FUZZY_MATCH_THRESHOLD=0.82
VECTOR_AUTO_ACCEPT_THRESHOLD=0.80
VECTOR_AUTO_REJECT_THRESHOLD=0.60

# --- Text-to-speech (mock provider used until a real key is set) ---
TTS_PROVIDER=mock
TTS_API_KEY=

# --- Fast Money ---
FAST_MONEY_TARGET=200
