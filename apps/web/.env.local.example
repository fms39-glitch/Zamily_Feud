NEXT_PUBLIC_SERVER_URL=http://localhost:4000
# Optional: WebRTC servers for the team mic, as JSON. Defaults to Google's public STUN, which works
# on most home networks; add a TURN relay (e.g. from a TURN provider) for strict office/school networks.
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
