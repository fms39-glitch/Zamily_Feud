{
  "name": "@zamily-feud/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dataset:normalize": "tsx src/scripts/normalizeDataset.ts",
    "dataset:import": "tsx src/scripts/importDataset.ts",
    "dataset:embed": "tsx src/scripts/embedAnswers.ts",
    "dataset:validate": "tsx src/scripts/validateDataset.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.3.3",
    "@zamily-feud/shared": "*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
